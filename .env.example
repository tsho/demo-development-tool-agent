# LLM Provider: "cortex" (default), "openai", "anthropic"
LLM_PROVIDER=cortex
LLM_MODEL=llama3.1-70b

# --- Snowflake Cortex (default provider) ---
# Uses ~/.snowflake/connections.toml by default.
# Or set these explicitly:
# SNOWFLAKE_ACCOUNT=your-account
# SNOWFLAKE_TOKEN=pat-...
# SNOWFLAKE_CONNECTION_NAME=default

# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-20250514

# --- AWS Bedrock ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# --- Google Vertex AI ---
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=

# --- HuggingFace ---
# HUGGINGFACE_API_KEY=hf_...

# --- Microsoft Azure OpenAI ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-azure-key
# OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deploy>/
# LLM_MODEL=gpt-4o

# --- OpenAI ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o
